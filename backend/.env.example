# CognoDB connection details — copy this file to .env and fill in real values.
# The password is shown once when the instance is created, so keep it safe.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Optional: comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
